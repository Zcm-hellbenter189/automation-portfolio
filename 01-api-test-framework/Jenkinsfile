/* =============================================================================
 * 接口自动化 · 持续集成流水线（Declarative Pipeline）
 *
 * 作用：定时（或代码提交后）自动执行接口自动化用例，产出 Allure / JUnit 报告，
 *       失败即让构建变红并通知——把「手动跑用例」升级为「持续测试」。
 *
 * 挂载方式：
 *   1. 把本文件放在仓库根 或 01-api-test-framework/ 下；
 *   2. Jenkins 新建 Pipeline 任务 → Pipeline script from SCM → 选择 Git 仓库；
 *   3. Script Path 填本文件的相对路径（如 01-api-test-framework/Jenkinsfile）。
 *
 * 依赖插件：Git（默认自带）、Pipeline（默认自带）、
 *          Allure Jenkins Plugin（必需，渲染报告）、
 *          Timestamper（**必需** —— options 里已启用 timestamps()，缺插件会在解析期直接失败）、
 *          Email Extension Plugin（可选，失败邮件通知）
 * 前置条件：Jenkins 节点需有可用的 Python 3.10+ 解释器（依赖由流水线自动安装）。
 *          ⚠️ 本文件 environment.PYTHON 写的是**本机绝对路径**（含 .venv）——
 *            迁移到其他机器/节点时**必须修改该值**，光"装了 Python"是不够的。
 *          依赖安装优先用锁文件：pip install -r requirements.lock.txt
 *          （锁文件缺失时回退 requirements.txt）
 *
 * 详细接入步骤（从装 Jenkins 到看报告、排错、实战踩坑记录）见 docs/jenkins-ci-guide.md
 * ============================================================================= */
pipeline {
    agent any

    options {
        timestamps()                                       // 每行日志加时间戳，排错必需
        timeout(time: 30, unit: 'MINUTES')                 // 防止用例卡死把执行节点占满
        buildDiscarder(logRotator(numToKeepStr: '30'))      // 只保留最近 30 次构建记录
        disableConcurrentBuilds()                           // 同任务串行，避免抢 Mock 端口
    }

    /* 触发方式（可组合：多个触发器之间是「或」关系，任一满足即触发一次构建）：
     * 本任务同时启用 cron + pollSCM，职责互补：pollSCM 管"提交即跑"（快速反馈），
     * cron 管"到点必跑"（夜间兜底，避免长期不提交就永远不跑）。
     *
     * ⚠️ 本项目 Webhook 走不通：Jenkins 跑在本机、无公网可达地址，
     *    GitHub/Gitee 的回调请求打不进来 ⇒ 感知代码变更只能靠 pollSCM。
     * ⚠️ pollSCM 只轮询【任务里配置的那一个仓库 URL】：本项目 Jenkins 从 Gitee 拉代码，
     *    只推 GitHub(origin) 等于没推，Jenkins 看不到变化 ⇒ 必须 pushall 两边都推。
     * 注意：两个触发源不会互相合并，同一份提交可能被跑两次（第二次算夜间复跑，可当 flaky用例探测）。
     *
     * 三种触发器的含义：
     *   cron        Jenkins 的 cron 语法；H 表示"散列"到某个分钟，避免整点抢资源
     *   pollSCM     轮询 Git 仓库，有变更就跑（本项目唯一可行的变更触发方式）
     *   Webhook     在仓库 Settings → Webhooks 指向 <jenkins>/github-webhook/（本项目不可用，见上）
     */
    triggers {
        //	H是 Jenkins 专有的:散列出来的固定某一分钟（0–59 之一）
        cron('H 2 * * *')                // 每天凌晨 2 点左右自动跑一次
        pollSCM('H/15 * * * *')          // 每约 15 分钟检查一次代码变更（H/15 = 先散列偏移再每 15 分钟）
    }

    environment {
        PYTHON = 'E:/ruanjian/Learn/WorkBuddy/automation-portfolio/.venv/Scripts/python.exe'
        PYTHONIOENCODING = 'utf-8'       // Windows 控制台输出中文必需，否则报告里是乱码
        PYTHONUNBUFFERED = '1'           // 日志实时刷出，不要等缓冲区满
    }

    stages {
        stage('Checkout') {
            steps {
                // 无需 checkout scm：Pipeline script from SCM 模式下，Jenkins 已在
                // 「Declarative: Checkout SCM」阶段自动拉取过代码，此处再 checkout 属于重复拉取
                // 打印本次构建对应的提交号：用例挂了能立刻定位是哪个 commit 引入的
                bat 'git rev-parse --short HEAD'
                // Linux 节点请改用： sh 'git rev-parse --short HEAD'
            }
        }

        /* ⚠️ 工作目录：Jenkins 默认在【仓库根】执行，
         * 而项目代码在 01-api-test-framework/ 下 —— 所以用 Jenkins 的 dir() 切进去。
         * 为什么不用 cd：bat 步骤每次都是新的 shell，cd 不会跨步骤保留。
         * 不切目录的后果：pip install -r requirements.txt 报
         *   "ERROR: Could not open requirements file: No such file or directory"
         */
        stage('Prepare') {
            steps {
                dir('01-api-test-framework') {
                    bat '"%PYTHON%" --version'
                    /* 优先装"锁文件"：requirements.lock.txt 记录每个依赖的确切版本，
                     * 保证 CI 装到的版本与开发机完全一致（消除"本地能过、CI 挂"的环境漂移）；
                     * 锁文件不存在时回退到 requirements.txt（只声明版本下限）。
                     * 锁文件由本地生成：pip install --dry-run --ignore-installed --report r.json -r requirements.txt
                     */
                    // ⚠️ 这里是 Groovy 的【单引号】字符串，${PYTHON} 不会被插值！
                    // 改用 Windows 批处理的 %PYTHON% —— Jenkins 的 environment 会把它注入构建环境，
                    // 批处理运行时再展开，效果等价。外层加双引号是防路径含空格。
                    bat 'if exist requirements.lock.txt ("%PYTHON%" -m pip install -r requirements.lock.txt) else ("%PYTHON%" -m pip install -r requirements.txt)'
                    // Linux 节点请改用 sh
                }
            }
        }

        stage('API Test') {
            steps {
                dir('01-api-test-framework') {
                    /* --ci     = --junitxml --allure，产出两种报告
                     * --env=test  多环境切换落地：接真实环境只改 config/config.yaml，用例零改动
                     * 不传 -m，CI 跑全量（含 slow 标记的用例）
                     * 退出码非 0 → 本阶段自动变红，这是持续集成的关键约定
                     */
                    bat '"%PYTHON%" run.py --env=test --ci'
                }
            }
        }
    }

    post {
        always {
            // 同样切到项目目录：报告产物都在 01-api-test-framework/reports/ 下，
            // 这里的相对路径是相对 workspace 根的，不切目录会找不到文件
            dir('01-api-test-framework') {
                /* 用例明细 + 通过率趋势图（Jenkins 任务页原生展示）
                 * allowEmptyResults：用例收集阶段就崩掉时不要连带 post 一起失败，掩盖真正的报错
                 */
                junit allowEmptyResults: true, testResults: 'reports/junit.xml'

                // Allure 报告（需 Allure Jenkins Plugin；缺插件此步会报错，装好即可）
                allure includeProperties: false, jdk: '', results: [[path: 'reports/allure-results']]

                // HTML 报告归档，便于下载取证
                archiveArtifacts artifacts: 'reports/report.html', allowEmptyArchive: true
            }
        }

        failure {
            echo 'API tests failed, check the Allure report for details'

            /* 企业微信机器人通知。
             * key 通过环境变量 WECOM_WEBHOOK_KEY 注入，**不要写进仓库**。
             *
             * ⚠️ 前置：必须先在 Jenkins 里创建 ID 为 `wecom-webhook-key` 的 **Secret text** 凭据。
             *    否则 withCredentials 会直接抛 CredentialNotFoundException 让 failure 块失败
             *    （**不是**"静默跳过"）。创建步骤见 docs/jenkins-ci-guide.md。
             *    只有"key 没能注入到脚本"这种情况，notify.py 才会打印提示并静默跳过。
             *
             * notify.py 内部吞掉所有异常并返回 0 —— 通知失败不该让构建「更红」。
             */
            dir('01-api-test-framework') {
                withCredentials([string(credentialsId: 'wecom-webhook-key', variable: 'WECOM_WEBHOOK_KEY')]) {
                    bat '"%PYTHON%" scripts/notify.py'
                }
            }

            /* 邮件通知示例（可选，需 Email Extension Plugin + 系统 SMTP 配置）：
             * emailext to: 'you@example.com',
             *          subject: "接口自动化失败: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
             *          body: "构建地址: ${env.BUILD_URL}\n请查看 Allure 报告中的失败用例。"
             */
        }
    }
}
